NEXT_PUBLIC_APP_ENV=development

# Optional cloud sync (Supabase). Leave both empty for a local-only build:
# the app then never contacts a backend. Only public client values belong
# here. NEVER put a service-role key (or any secret) in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
